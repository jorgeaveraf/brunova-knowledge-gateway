# Non-secret Google Workspace configuration
WORKSPACE_DELEGATED_USER=brunova@brunova.mx
WORKSPACE_SERVICE_ACCOUNT_EMAIL=brunova-knowledge-agent@brunova-ai-platform.iam.gserviceaccount.com
WORKSPACE_DOC_MAX_CHARS=10000
WORKSPACE_SHEET_MAX_CELLS=1000
WORKSPACE_SOURCE_REGISTRY_PATH=app/config/sources.yaml
WORKSPACE_BLOCKED_SOURCE_IDS=blocked-resource-or-folder-id
WORKSPACE_SOURCE_MAX_DEPTH=20
WORKSPACE_AUDIT_ENABLED=true
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Optional; only needed for browser-based MCP clients
MCP_ALLOWED_ORIGINS=
# Secret: inject at runtime from Secret Manager; never store a value here
BRUNOVA_GATEWAY_TOKEN=<configure-outside-repository>
