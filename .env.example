# Non-secret Google Workspace configuration
WORKSPACE_DELEGATED_USER=brunova@brunova.mx
WORKSPACE_SERVICE_ACCOUNT_EMAIL=brunova-knowledge-agent@brunova-ai-platform.iam.gserviceaccount.com
WORKSPACE_DOC_MAX_CHARS=10000
WORKSPACE_SHEET_MAX_CELLS=1000
WORKSPACE_SOURCE_REGISTRY_PATH=app/config/sources.yaml
WORKSPACE_BLOCKED_SOURCE_IDS=blocked-resource-or-folder-id
WORKSPACE_SOURCE_MAX_DEPTH=20
WORKSPACE_AUDIT_ENABLED=true
SOURCE_PROPOSAL_BUCKET=
SOURCE_PROPOSAL_OBJECT=source_proposals.yaml
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Optional; only needed for browser-based MCP clients
MCP_ALLOWED_ORIGINS=
# Secret: inject at runtime from Secret Manager; never store a value here
BRUNOVA_GATEWAY_TOKEN=<configure-outside-repository>

# Non-secret HubSpot Remote MCP configuration
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_APP_ID=
HUBSPOT_MCP_SERVER_URL=https://mcp.hubspot.com
HUBSPOT_MCP_REDIRECT_URI=https://brunova-knowledge-gateway-36958632716.us-central1.run.app/auth/hubspot/callback
HUBSPOT_OAUTH_STATE_BUCKET=brunova-ai-platform-36958632716-knowledge-gateway-state
HUBSPOT_OAUTH_STATE_PREFIX=oauth/hubspot
HUBSPOT_OAUTH_STATE_TTL_SECONDS=600
# Secret: inject at runtime from Google Secret Manager; keep empty in files
HUBSPOT_MCP_CLIENT_SECRET=

# n8n MCP discovery/runtime controls (non-secret)
N8N_DISCOVERY_TTL_SECONDS=60
N8N_TIMEOUT_SECONDS=30
# Secret: inject the complete MCP configuration from Google Secret Manager
N8N_MCP_JSON=<configure-outside-repository>
